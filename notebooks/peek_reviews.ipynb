   "source": [
    "import gzip, json\n",
    "from pathlib import Path\n",
    "\n",
    "# path file review\n",
    "REVIEW_PATH = Path('../data/amazon/Clothing_Shoes_and_Jewelry.jsonl.gz')\n",
    "\n",
    "# just read first 5 records\n",
    "records = []\n",
    "with gzip.open(REVIEW_PATH, 'rt', encoding='utf-8') as f:\n",
    "    for i, line in enumerate(f):\n",
    "        if i >= 5: break\n",
    "        records.append(json.loads(line))\n",
    "\n",
    "print('Keys:', list(records[0].keys()))\n",
    "print()\n",
    "print('First review:')\n",
    "print(json.dumps(records[0], indent=2))"
   ]
  }
